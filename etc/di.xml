<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="RubikFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">MageBooster\Rubik\Model\Settings::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">MageBooster\Rubik\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">RubikValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">RubikValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">RubikCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">MageBooster\Rubik\Model\Settings::CODE</argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">RubikConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">RubikConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">RubikConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">RubikCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">MageBooster\Rubik\Gateway\Command\InitializeCommand</item>
                <item name="refund" xsi:type="string">MageBooster\Rubik\Gateway\Command\RefundCommand</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageBooster\Rubik\Block\Info">
        <arguments>
            <argument name="config" xsi:type="object">RubikConfig</argument>
        </arguments>
    </type>
    <type name="MageBooster\Rubik\Model\Settings">
        <arguments>
            <argument name="config" xsi:type="object">RubikConfig</argument>
        </arguments>
    </type>
    <virtualType name="RubikLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/magebooster_mbrubik.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="RubikMonolog" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">magebooster_mbrubik</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">RubikLogHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageBooster\Rubik\Model\DebugLog">
        <arguments>
            <argument name="logger" xsi:type="object">RubikMonolog</argument>
        </arguments>
    </type>
</config>
